# -*- mode: ini -*-

font-family = Source Code Pro
font-size = 11
shell-integration-features = no-cursor,no-path
bell-features = system,no-title
cursor-style = bar
cursor-style-blink = true
adjust-cursor-thickness = 3

# Palette, background/foreground, cursor and selection all come from the theme
# file, which is generated into ~/.config/ghostty/themes/ (ghostty's first theme
# search dir) by the 2026-color-scheme run_onchange script. Regenerate it with
# `chezmoi apply ~/.local/share/dotfiles/2026-color-scheme` after editing the
# generator; do not paste colors back in here.
theme = 2026-color-scheme-public-dark
