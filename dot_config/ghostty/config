font-family = Source Code Pro
font-size = 11
theme = Catppuccin Macchiato
shell-integration-features = no-cursor,no-path
bell-features = system,no-title
cursor-style = bar
cursor-style-blink = true
adjust-cursor-thickness = 3

# https://github.com/earendil-works/pi/blob/v0.70.2/packages/coding-agent/docs/terminal-setup.md
keybind = alt+backspace=text:\x1b\x7f
