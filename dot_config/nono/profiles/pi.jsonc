{
  "$schema": "https://raw.githubusercontent.com/nolabs-ai/nono/refs/tags/v0.65.1/crates/nono-cli/data/nono-profile.schema.json",
  "extends": "base",
  "meta": {
    "name": "pi",
  },
  "groups": {
    "include": ["unlink_protection"],
  },
  "environment": {
    "set_vars": {
      "GATEKEEPER_PLANNOTATOR_BIN": "/Users/themaxdavitt/.local/share/mise/installs/github-backnotprop-plannotator/0.21.1/plannotator",
    },
  },
  "network": {
    "credentials": ["github", "openrouter"],
    "custom_credentials": {
      "github": {
        "upstream": "https://api.github.com",
        "credential_key": "env://GH_TOKEN",
        "env_var": "GH_TOKEN",
      },
      "openrouter": {
        "upstream": "https://openrouter.ai/api/v1",
        "credential_key": "env://OPENROUTER_API_KEY",
        "env_var": "OPENROUTER_API_KEY",
      },
    },
    "open_port": [0],
  },
  "filesystem": {
    "allow": ["~/.pi/agent/sessions", "~/.pi/agent/gatekeeper", "~/.plannotator"],
    "allow_file": [
      "~/.pi/agent/auth.json",
      "~/.pi/agent/auth.json.lock",
      "~/.pi/agent/settings.json",
      "~/.pi/agent/settings.json.lock",
    ],
    "read": ["~/.claude/skills", "~/.pi/agent/extensions"],
  },
  "open_urls": {
    "allow_origins": ["https://auth.openai.com"],
    "allow_localhost": true,
  },
  "allow_launch_services": true,
  "interactive": true,
}
